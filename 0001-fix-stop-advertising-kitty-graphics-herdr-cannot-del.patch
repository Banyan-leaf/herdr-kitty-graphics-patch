diff --git a/crates/ghostty-vt/src/lib.rs b/crates/ghostty-vt/src/lib.rs
index 7deaaa8..b25f8d1 100644
--- a/crates/ghostty-vt/src/lib.rs
+++ b/crates/ghostty-vt/src/lib.rs
@@ -1059,6 +1059,28 @@ impl Terminal {
         Ok(())
     }
 
+    /// Disable the Kitty graphics protocol for this terminal.
+    ///
+    /// libghostty treats a zero image-storage limit as "images unsupported":
+    /// every graphics command is ignored and capability queries (`a=q`) go
+    /// unanswered, so a probing child sees a terminal without the protocol.
+    /// A terminal that cannot have its placements rendered must reach this
+    /// state, otherwise the child is told "supported" and paints images that
+    /// never appear.
+    pub fn disable_kitty_graphics(&mut self) -> Result<(), Error> {
+        let storage_limit: u64 = 0;
+        // SAFETY: self.raw is a live terminal handle and storage_limit is a plain value.
+        unsafe {
+            ffi::ghostty_terminal_set(
+                self.raw,
+                ffi::GhosttyTerminalOption_GHOSTTY_TERMINAL_OPT_KITTY_IMAGE_STORAGE_LIMIT,
+                (&storage_limit as *const u64).cast(),
+            )
+            .into_result()?;
+        }
+        Ok(())
+    }
+
     pub fn enable_kitty_graphics(&mut self) -> Result<(), Error> {
         install_png_decoder_once();
         let storage_limit = KITTY_IMAGE_STORAGE_LIMIT_BYTES;
@@ -4019,6 +4041,39 @@ mod tests {
         assert!(!terminal.kitty_graphics_may_have_placements().unwrap());
     }
 
+    #[test]
+    fn disabled_kitty_graphics_ignores_protocol_and_capability_queries() {
+        let mut terminal = Terminal::new(10, 5, 0).unwrap();
+        let responses = std::sync::Arc::new(std::sync::Mutex::new(Vec::<u8>::new()));
+        let sink = responses.clone();
+        terminal
+            .set_write_pty_callback(move |bytes| sink.lock().unwrap().extend_from_slice(bytes))
+            .unwrap();
+
+        // The capability query a probing TUI sends: one transparent RGBA pixel
+        // in direct data, answered with OK while the protocol is usable.
+        const QUERY: &[u8] = b"\x1b_Gi=31,s=1,v=1,a=q,t=d,f=32;AAAAAA==\x1b\\";
+        terminal.enable_kitty_graphics().unwrap();
+        terminal.write(QUERY);
+        let reply = String::from_utf8_lossy(&responses.lock().unwrap()[..]).into_owned();
+        assert!(reply.contains("OK"), "{reply}");
+
+        // Positive control: the same paint command does place an image here.
+        terminal.write(b"\x1b_Ga=T,t=d,f=24,i=7,s=1,v=2,c=1,r=1;////////\x1b\\");
+        assert_eq!(terminal.kitty_image_placements().unwrap().len(), 1);
+
+        responses.lock().unwrap().clear();
+        terminal.disable_kitty_graphics().unwrap();
+        terminal.write(QUERY);
+        terminal.write(b"\x1b_Ga=T,t=d,f=24,i=8,s=1,v=2,c=1,r=1;////////\x1b\\");
+
+        // Disabled graphics are indistinguishable from an unsupported terminal:
+        // no reply to the query, no stored image, no placement.
+        assert!(responses.lock().unwrap().is_empty());
+        assert!(terminal.kitty_image_placements().unwrap().is_empty());
+        assert!(!terminal.kitty_graphics_may_have_placements().unwrap());
+    }
+
     #[test]
     fn build_info_contract_matches_expected_vendored_features() {
         let _simd = build_info_bool(ffi::GhosttyBuildInfo_GHOSTTY_BUILD_INFO_SIMD);
