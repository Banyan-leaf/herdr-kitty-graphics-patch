 }
 
+/// Outcome of the pre-handshake outer-terminal graphics probe.
+pub(super) struct HostGraphicsProbe {
+    /// True when the outer terminal answered the Kitty capability query.
+    pub(super) renders_kitty_graphics: bool,
+    /// Host input read while probing, replayed into the input loop.
+    pub(super) buffered_input: Vec<u8>,
+}
+
+#[cfg(not(windows))]
+const HOST_GRAPHICS_QUERY_TIMEOUT: Duration = Duration::from_millis(250);
+/// One transparent RGBA pixel as zlib-compressed direct data, followed by the
+/// DA1 sentinel. Terminals answer queries in order, so a terminal that
+/// implements the protocol replies before the sentinel and one that does not
+/// answers only the sentinel. This is the query image-capable TUIs send.
+#[cfg(not(windows))]
+const HOST_GRAPHICS_QUERY: &[u8] =
+    b"\x1b_Gi=31,s=1,v=1,a=q,t=d,f=32,o=z;eAFjYGBgAAAABAAB\x1b\\\x1b[c";
+#[cfg(not(windows))]
+const HOST_GRAPHICS_QUERY_IMAGE_ID: u32 = 31;
+
+/// Ask the outer terminal whether it can load and display images.
+///
+/// Only positive evidence removes the capability: a terminal that never
+/// answers, or that answers the DA1 sentinel first, cannot show placements.
+/// Anything inconclusive keeps the optimistic answer, so an interactive
+/// terminal that was working before this probe existed keeps working.
+///
+/// Runs before the handshake, so it owns raw mode for the duration of the
+/// query (terminal replies are not line-delimited) and restores the previous
+/// mode before returning. Host input read meanwhile is returned for replay.
+#[cfg(not(windows))]
+pub(super) fn probe_host_kitty_graphics() -> HostGraphicsProbe {
+    if !io::stdin().is_terminal() || crossterm::terminal::enable_raw_mode().is_err() {
+        return HostGraphicsProbe {
+            renders_kitty_graphics: true,
+            buffered_input: Vec::new(),
+        };
+    }
+    let probe = probe_host_kitty_graphics_raw();
+    let _ = crossterm::terminal::disable_raw_mode();
+    probe
+}
+
+/// Windows keeps the optimistic answer: the Windows input backend has no
+/// non-blocking host query yet, so graphics stay enabled exactly as they were
+/// before this probe existed.
+#[cfg(windows)]
+pub(super) fn probe_host_kitty_graphics() -> HostGraphicsProbe {
+    HostGraphicsProbe {
+        renders_kitty_graphics: true,
+        buffered_input: Vec::new(),
+    }
+}
+
+#[cfg(not(windows))]
+fn probe_host_kitty_graphics_raw() -> HostGraphicsProbe {
+    let mut buffered_input = Vec::new();
+    if io::stdout()
+        .write_all(HOST_GRAPHICS_QUERY)
+        .and_then(|()| io::stdout().flush())
+        .is_err()
+    {
+        return HostGraphicsProbe {
+            renders_kitty_graphics: true,
+            buffered_input,
+        };
+    }
+
+    let mut saw_graphics_reply = false;
+    let mut saw_sentinel = false;
+    // Bypass StdinLock's shared buffer so poll and read observe the same bytes.
+    let stdin = io::stdin();
+    let stdin_fd = stdin.as_raw_fd();
+    let deadline = Instant::now() + HOST_GRAPHICS_QUERY_TIMEOUT;
+    while !saw_sentinel && buffered_input.len() < MAX_BUFFERED_HOST_INPUT {
+        let Some(remaining) = deadline.checked_duration_since(Instant::now()) else {
+            break;
+        };
+        let timeout_ms = remaining.as_millis().clamp(1, i32::MAX as u128) as i32;
+        match crate::platform::poll_fd_readable(stdin_fd, timeout_ms) {
+            Ok(true) => {}
+            Ok(false) => break,
+            Err(err) if err.kind() == io::ErrorKind::Interrupted => continue,
+            Err(err) => {
+                tracing::debug!(%err, "host graphics query read unavailable");
+                break;
+            }
+        }
+
+        let mut scratch = [0u8; 4096];
+        let capacity = MAX_BUFFERED_HOST_INPUT - buffered_input.len();
+        let read_limit = capacity.min(scratch.len());
+        match crate::platform::read_fd(stdin_fd, &mut scratch[..read_limit]) {
+            Ok(0) => break,
+            Ok(read) => {
+                buffered_input.extend_from_slice(&scratch[..read]);
+                consume_host_graphics_probe_responses(
+                    &mut buffered_input,
+                    &mut saw_graphics_reply,
+                    &mut saw_sentinel,
+                );
+            }
+            Err(err) if err.kind() == io::ErrorKind::Interrupted => continue,
+            Err(err) => {
+                tracing::debug!(%err, "host graphics query read failed");
+                break;
+            }
+        }
+    }
+
+    HostGraphicsProbe {
+        // Only the terminal's own OK reply proves support; silence, or a
+        // sentinel answered first, means placements would never appear.
+        renders_kitty_graphics: saw_graphics_reply,
+        buffered_input,
+    }
+}
+
+/// Consume this probe's own replies: the graphics reply and the DA1 sentinel.
+/// Everything else stays buffered for the input loop (the user can type while
+/// the query is in flight).
+#[cfg(not(windows))]
+fn consume_host_graphics_probe_responses(
+    buffered_input: &mut Vec<u8>,
+    saw_graphics_reply: &mut bool,
+    saw_sentinel: &mut bool,
+) {
+    let mut offset = 0;
+    while offset < buffered_input.len() {
+        let rest = &buffered_input[offset..];
+        if let Some(payload) = rest.strip_prefix(b"\x1b_G") {
+            let Some(terminator) = payload.windows(2).position(|bytes| bytes == b"\x1b\\") else {
+                break;
+            };
+            let sequence_end = offset + 3 + terminator + 2;
+            let sequence = &buffered_input[offset..sequence_end];
+            match kitty_graphics_reply_image_id(sequence) {
+                // Our own reply: consume it, and remember whether it said OK.
+                Some(image_id) if image_id == HOST_GRAPHICS_QUERY_IMAGE_ID => {
+                    *saw_graphics_reply |= kitty_graphics_reply_is_ok(sequence);
+                    buffered_input.drain(offset..sequence_end);
+                    continue;
+                }
+                // Some other APC payload: leave it for the input loop.
+                _ => {
+                    offset = sequence_end;
+                    continue;
+                }
+            }
+        }
+        if rest.starts_with(b"\x1b[") {
+            // DA1 is CSI ? Pp ; Ps... c: the private marker is part of it.
+            let mut end = offset + 2;
+            while end < buffered_input.len()
+                && (buffered_input[end].is_ascii_digit()
+                    || buffered_input[end] == b';'
+                    || buffered_input[end] == b'?')
+            {
+                end += 1;
+            }
+            match buffered_input.get(end) {
+                // Incomplete sequence: wait for the rest.
+                None => break,
+                Some(b'c') => {
+                    *saw_sentinel = true;
+                    buffered_input.drain(offset..=end);
+                    continue;
+                }
+                Some(_) => {
+                    offset += 1;
+                    continue;
+                }
+            }
+        }
+        offset += 1;
+    }
+}
+
+/// The image id of a Kitty graphics reply, when the sequence is one.
+#[cfg(not(windows))]
+fn kitty_graphics_reply_image_id(sequence: &[u8]) -> Option<u32> {
+    let control = kitty_graphics_reply_control(sequence)?;
+    control
+        .split(|byte| *byte == b',')
+        .find_map(|field| field.strip_prefix(b"i="))
+        .and_then(|value| std::str::from_utf8(value).ok())
+        .and_then(|value| value.parse().ok())
+}
+
+/// Whether a Kitty graphics reply reports success.
+#[cfg(not(windows))]
+fn kitty_graphics_reply_is_ok(sequence: &[u8]) -> bool {
+    let Some(payload) = sequence
+        .strip_prefix(b"\x1b_G")
+        .and_then(|payload| payload.strip_suffix(b"\x1b\\"))
+    else {
+        return false;
+    };
+    let Some(separator) = payload.iter().position(|byte| *byte == b';') else {
+        return false;
+    };
+    payload[separator + 1..].starts_with(b"OK")
+}
+
+#[cfg(not(windows))]
+fn kitty_graphics_reply_control(sequence: &[u8]) -> Option<&[u8]> {
+    let payload = sequence.strip_prefix(b"\x1b_G")?.strip_suffix(b"\x1b\\")?;
+    let separator = payload.iter().position(|byte| *byte == b';')?;
+    Some(&payload[..separator])
+}
+
 #[cfg(windows)]
 fn query_host_escape_disambiguation() -> (bool, Vec<u8>) {
     (false, Vec::new())
