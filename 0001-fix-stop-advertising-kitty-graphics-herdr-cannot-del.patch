+    fn graphics_probe_keeps_typed_input_and_waits_for_a_complete_reply() {
+        // Typed input plus the first half of the reply, in one read.
+        let mut buffered = b"hi\x1b_Gi=31;O".to_vec();
+        let mut reply = false;
+        let mut sentinel = false;
+        consume_host_graphics_probe_responses(&mut buffered, &mut reply, &mut sentinel);
+        assert!(!reply);
+        assert!(!sentinel);
+        assert_eq!(buffered, b"hi\x1b_Gi=31;O", "an incomplete reply is kept");
+
+        // The rest arrives: the reply is consumed, the typed bytes are not.
+        buffered.extend_from_slice(b"K\x1b\\");
+        consume_host_graphics_probe_responses(&mut buffered, &mut reply, &mut sentinel);
+        assert!(reply);
+        assert!(!sentinel);
+        assert_eq!(buffered, b"hi");
+    }
+
+    #[cfg(not(windows))]
+    #[test]
+    fn graphics_probe_ignores_foreign_graphics_replies() {
+        let mut buffered = b"\x1b_Gi=7;ENOENT\x1b\\".to_vec();
+        let mut reply = false;
+        let mut sentinel = false;
+        consume_host_graphics_probe_responses(&mut buffered, &mut reply, &mut sentinel);
+        assert!(!reply);
+        assert_eq!(
+            buffered, b"\x1b_Gi=7;ENOENT\x1b\\",
+            "another image's reply belongs to the input loop"
+        );
+    }
+
+    #[cfg(not(windows))]
+    #[test]
+    fn graphics_probe_reply_requires_an_ok_for_its_own_image() {
+        assert_eq!(
+            kitty_graphics_reply_image_id(b"\x1b_Gi=31;OK\x1b\\"),
+            Some(31)
+        );
+        assert_eq!(
+            kitty_graphics_reply_image_id(b"\x1b_Gi=31,I=5,p=1;OK\x1b\\"),
+            Some(31)
+        );
+        assert_eq!(kitty_graphics_reply_image_id(b"\x1b_Gi=31;OK"), None);
+        assert_eq!(kitty_graphics_reply_image_id(b"\x1b_G31;OK\x1b\\"), None);
+        assert!(kitty_graphics_reply_is_ok(b"\x1b_Gi=31;OK\x1b\\"));
+        assert!(kitty_graphics_reply_is_ok(b"\x1b_Gi=31,p=1;OK\x1b\\"));
+        assert!(!kitty_graphics_reply_is_ok(b"\x1b_Gi=31;EINVAL\x1b\\"));
+    }
 }
