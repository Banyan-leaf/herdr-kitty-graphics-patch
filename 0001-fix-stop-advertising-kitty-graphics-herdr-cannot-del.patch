diff --git a/src/client/terminal_setup.rs b/src/client/terminal_setup.rs
index 249e29a..ace0316 100644
--- a/src/client/terminal_setup.rs
+++ b/src/client/terminal_setup.rs
@@ -1,5 +1,7 @@
 //! Terminal setup and restoration for the rendered client.
 
+#[cfg(not(windows))]
+use std::io::IsTerminal as _;
 use std::io::{self, Write as _};
 #[cfg(not(windows))]
 use std::os::fd::AsRawFd as _;
@@ -321,6 +323,217 @@ fn host_control_string_end(bytes: &[u8]) -> Option<Option<usize>> {
